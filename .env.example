# ---------------------------------------------------------------------------
# RideSync AI server configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# Only emails at this domain can sign in (enforced by the server).
ALLOWED_EMAIL_DOMAIN=vit.edu.in

# Contact address shown in the Privacy Policy (/privacy) and Terms of Use (/terms) for questions and complaints.
SUPPORT_EMAIL=

# Public address of the site (no trailing slash). Used for the Microsoft sign-in redirect.
# Local: http://localhost:5173   Live: https://your-app.onrender.com
PUBLIC_URL=http://localhost:5173

# Sign in with Microsoft — for @vit.edu.in (Microsoft 365 / Outlook) accounts. Free.
# Register an app at https://entra.microsoft.com → App registrations (see README).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: VIT's tenant is looked up automatically from ALLOWED_EMAIL_DOMAIN.
# MICROSOFT_TENANT_ID=c7b00d7f-ad99-442a-b12f-c2c912044fdc

# Google sign-in (only useful if your college email runs on Google): create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add your site URL
# (e.g. http://localhost:5173 and https://your-domain) to "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Email login codes (works even if the college mail isn't Google Workspace).
# Any SMTP provider works: Gmail (app password), Brevo, Resend, Zoho, Amazon SES…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RideSync <no-reply@your-domain>"

# Optional BACKUP sender — used automatically when the main one hits its daily limit.
# A free Brevo account (300/day) + Gmail (~500/day) ≈ 800 login codes a day for free.
SMTP2_HOST=
SMTP2_PORT=587
SMTP2_USER=
SMTP2_PASS=
MAIL2_FROM=

# How long a login lasts on a device (days). Longer = fewer login emails.
SESSION_DAYS=90

# Where the SQLite database lives. Put this on a persistent disk in production.
DATABASE_PATH=./data/ridesync.db

PORT=8787

# ---- Maps (all optional — free OpenStreetMap services are used without keys) ----
# Google Maps: map, place search, current-location names and driving routes.
# Needs a Google Cloud project with billing on; enable Maps JavaScript API, Places API (New),
# Geocoding API and Routes API. If Google fails, RideSync falls back to the free services.
GOOGLE_MAPS_API_KEY=
# Optional second key for the map in the browser, restricted to your website address.
# GOOGLE_MAPS_BROWSER_KEY=
# Set to false to keep the free map but still use Google search and routes (saves map-load costs).
# GOOGLE_MAPS_DISPLAY=true
# MapTiler: map tiles + place search. Free key at https://cloud.maptiler.com
MAPTILER_KEY=
# OpenRouteService: driving routes. Free key at https://openrouteservice.org
ORS_API_KEY=
# OSRM_URL=https://router.project-osrm.org

# ---- Payments (optional) — Razorpay online payments ----
# razorpay.com → Dashboard (Test mode) → Account & Settings → API Keys.
# Test keys (rzp_test_...) never move real money. Live keys need Razorpay KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Dashboard → Webhooks → URL https://your-site/api/payments/razorpay/webhook,
# events payment.captured + order.paid, then paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=

# Local development only — lets you sign in as any @ALLOWED_EMAIL_DOMAIN address
# without Google or email so you can test two accounts. Ignored in production.
DEV_LOGIN=false

# Shown in the in-ride SOS sheet only when set (frontend build-time variable).
VITE_CAMPUS_SECURITY_PHONE=

# Live traffic in ETAs, routes and the map (free at developer.tomtom.com, no card)
TOMTOM_KEY=

# Indian building/society names for dropped pins, and search (maps.olakrutrim.com)
OLA_MAPS_KEY=

# Login codes are also printed in the start.bat window on your laptop (never when deployed). Set to false to hide them.
# SHOW_LOGIN_CODES=false

# Live Indian traffic for trip times (free plan, apis.mappls.com → REST API key)
MAPPLS_KEY=
